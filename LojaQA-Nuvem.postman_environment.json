<style>
.professor-conteudo {
    display: none !important;
}

.professor-card.professor-aberto .professor-conteudo {
    display: block !important;
}

.professor-toggle {
    cursor: pointer;
}

.professor-toggle:hover,
.professor-toggle:focus {
    text-decoration: none !important;
}
</style>
<script>
document.addEventListener('click', function(event) {
    var fechar = event.target.closest('.professor-fechar');
    if (fechar) {
        event.preventDefault();
        var cardFechar = fechar.closest('.professor-card');
        if (cardFechar) {
            cardFechar.classList.remove('professor-aberto');
            var controleFechar = cardFechar.querySelector('.professor-toggle');
            if (controleFechar) {
                controleFechar.setAttribute('aria-expanded', 'false');
                controleFechar.focus();
            }
        }
        return;
    }

    var controle = event.target.closest('.professor-toggle');
    if (controle) {
        event.preventDefault();
        var card = controle.closest('.professor-card');
        if (card) {
            var abriu = card.classList.toggle('professor-aberto');
            controle.setAttribute('aria-expanded', abriu ? 'true' : 'false');
        }
    }
});
</script>
